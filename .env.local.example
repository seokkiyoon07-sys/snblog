# 수능 학생 정보 CSV 데이터
# 실제 사용시 .env.local 파일을 생성하고 아래 형식으로 학생 정보를 입력하세요
# Vercel 배포시에는 Vercel Dashboard > Settings > Environment Variables에서 설정하세요

STUDENTS_CSV_DATA="name,phone,examLocation,examAddress,dormLocation,dormAddress,studyLocation,studyAddress
홍길동,1234,서울대학교,서울시 관악구 관악로 1,SN숙소,서울시 강남구 테헤란로 123,SN독서실,서울시 강남구 테헤란로 456
김철수,5678,연세대학교,서울시 서대문구 연세로 50,SN숙소,서울시 강남구 테헤란로 123,SN독서실,서울시 강남구 테헤란로 456
이영희,9012,고려대학교,서울시 성북구 안암로 145,SN숙소,서울시 강남구 테헤란로 123,SN독서실,서울시 강남구 테헤란로 456"

# Notion Integration (기존 설정)
NOTION_TOKEN=secret_xxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jandi Webhook (기존 설정)
JANDI_WEBHOOK_URL=https://wh.jandi.com/connect-api/webhook/...

# 관리자 Google 로그인
# Google Cloud OAuth 승인된 리디렉션 URI:
# - http://localhost:3000/api/auth/callback/google
# - https://blog.snacademy.co.kr/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com

# 관리자 방문 통계
# 읽기 전용으로 사용할 Vercel Access Token. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
VERCEL_ANALYTICS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# 이 저장소의 기본 프로젝트/팀 ID는 코드에 설정되어 있습니다.
# 다른 Vercel 프로젝트에서 사용할 때만 아래 값을 덮어쓰세요.
VERCEL_ANALYTICS_PROJECT_ID=prj_RZ2Da2p5MIh1eSUoTfA5m5rGiAK4
VERCEL_ANALYTICS_TEAM_ID=team_azWZQdpq0IXyFJSOr0se7Wpx
